---
import SiteLayout from '../layouts/SiteLayout.astro'
import { getPageEntry, profile } from '../data/site-content/index.js'
import { pagePath } from '../utils/routes.js'

const home = getPageEntry('home')
const about = getPageEntry('about')
const HomeContent = home.Content
const AboutContent = about.Content
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`
---

<SiteLayout title="Vijini Mallawaarachchi" activeSlug="home">
  <article class="home-grid">
    <section class="hero">
      <div class="hero-copy">
        <h1 class="hero-name" aria-label="Vijini G. Mallawaarachchi">
          <span>Vijini G.</span>
          <span>Mallawaarachchi</span>
        </h1>
        <p class="hero-title">
          <a
            href="https://www.flinders.edu.au/people/vijini.mallawaarachchi"
            target="_blank"
            rel="noreferrer"
          >
            {profile.role}
          </a>
        </p>
        <p class="lede">
          Hi, I am Vijini Mallawaarachchi. I am a researcher, a hodophile, and
          a blogger working at the intersection of computer science and microbial
          genomics. I develop computational methods and tools to explore complex
          biological data while sharing my research and other interests through
          writing.
        </p>
        <p class="erdos-note">
          My
          <a
            href="https://mathscinet.ams.org/mathscinet/freetools/collab-dist?source=1472674&target=189017"
            target="_blank"
            rel="noreferrer"
          >
            Erdös Number
          </a>
          is 4.
        </p>
        <div class="hero-actions">
          <a href={pagePath('research')}>Research</a>
          <a href={pagePath('publications')}>Publications</a>
        </div>
      </div>
      <div class="hero-portrait">
        <img src={profile.image} alt={profile.name} />
      </div>
    </section>

    <section class="intro-columns markdown-content" aria-label="Biography and current work">
      <AboutContent />
      <HomeContent />
    </section>

    <section class="memorial-section" aria-labelledby="yu-lin-memorial-title">
      <div class="memorial-copy">
        <h2 id="yu-lin-memorial-title">
          In loving memory of our dear PhD supervisor
          <a
            href="https://xuehansheng.github.io/Yu_CV_2022.pdf"
            target="_blank"
            rel="noreferrer"
          >
            Dr. Yu Lin
          </a>
        </h2>
      </div>
      <a
        class="memorial-image-link"
        href="https://cgg-anu.github.io/"
        target="_blank"
        rel="noreferrer"
        aria-label="Visit the Computational Genomics Group website"
      >
        <img
          src={`${base}memorial-images/yu-lin-memorial.png`}
          alt="Memorial tribute image for Dr. Yu Lin"
          width="1279"
          height="1279"
          loading="lazy"
        />
      </a>
    </section>
  </article>
</SiteLayout>
