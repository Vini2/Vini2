---
import SiteLayout from '../../layouts/SiteLayout.astro'
import { getPageEntry } from '../../data/site-content/index.js'

const blogPage = getPageEntry('blog')
const postModules = import.meta.glob('../../data/blog/*/index.md', { eager: true })
const rawPostModules = import.meta.glob('../../data/blog/*/index.md', {
  eager: true,
  query: '?raw',
  import: 'default',
})

function decodeHtml(value = '') {
  return value
    .replace(/&#(\d+);/g, (_, code) => String.fromCharCode(Number(code)))
    .replace(/&#x([0-9a-f]+);/gi, (_, code) => String.fromCharCode(parseInt(code, 16)))
    .replace(/&nbsp;/g, ' ')
    .replace(/&amp;/g, '&')
    .replace(/&quot;/g, '"')
    .replace(/&apos;/g, "'")
    .replace(/&lt;/g, '<')
    .replace(/&gt;/g, '>')
}

function excerptFromBody(rawPost = '') {
  const body = rawPost.replace(/^---[\s\S]*?---/, '')
  const paragraph =
    body
      .split(/\n{2,}/)
      .find((block) => {
        const trimmed = block.trim()
        return (
          trimmed &&
          !trimmed.startsWith('#') &&
          !trimmed.startsWith('![') &&
          !trimmed.startsWith('```') &&
          !trimmed.startsWith('>') &&
          !/^\d+\.\s/.test(trimmed) &&
          !/^[-*]\s/.test(trimmed)
        )
      }) ?? body
  const text = decodeHtml(
    paragraph
      .replace(/<script[\s\S]*?<\/script>/gi, '')
      .replace(/<style[\s\S]*?<\/style>/gi, '')
      .replace(/<[^>]*>/g, ' ')
      .replace(/!\[[^\]]*]\([^)]+\)/g, ' ')
      .replace(/\[([^\]]+)]\([^)]+\)/g, '$1')
      .replace(/[`*_~>#]/g, '')
      .replace(/\s+/g, ' ')
      .trim(),
  )
  const sentences = text.match(/[^.!?]+[.!?]+(?:["')\]]+)?/g)
  return (sentences ? sentences.slice(0, 2).join(' ') : text).trim()
}

const posts = Object.entries(postModules)
  .map(([path, module]) => {
    const rawPost = rawPostModules[path]

    return {
      ...module.frontmatter,
      Content: module.Content,
      excerpt: excerptFromBody(rawPost),
    }
  })
  .sort((left, right) => new Date(right.date) - new Date(left.date))

const title = 'Blog | Vijini Mallawaarachchi'
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`
const blogPath = (slug) => `${base}blog/${slug}/`
const assetPath = (path) => `${base}${path.replace(/^\//, '')}`
---

<SiteLayout title={title} activeSlug="blog">
  <article class="page-section blog-index">
    <h1>{blogPage.title}</h1>
    {blogPage.intro && <p class="lede">{blogPage.intro}</p>}

    <section class="blog-list" aria-label="Blog articles">
      {
        posts.map((post) => (
          <article class="blog-card">
            {post.featuredImage && (
              <a class="blog-card-media" href={blogPath(post.slug)}>
                <img src={assetPath(post.featuredImage)} alt="" loading="lazy" />
              </a>
            )}
            <div class="blog-card-copy">
              <p class="meta">
                <time datetime={post.date}>
                  {new Date(`${post.date}T00:00:00`).toLocaleDateString('en', {
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric',
                  })}
                </time>
                {post.categories?.length ? ` / ${post.categories.join(', ')}` : ''}
              </p>
              <h2>
                <a href={blogPath(post.slug)}>{post.title}</a>
              </h2>
              {post.excerpt && <p>{post.excerpt}</p>}
              <a class="text-link" href={blogPath(post.slug)}>Read article</a>
            </div>
          </article>
        ))
      }
    </section>
  </article>
</SiteLayout>
